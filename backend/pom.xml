<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.trycore</groupId>
    <artifactId>evm-backend</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>
    <name>evm-backend</name>
    <description>Backend del sistema de Valor Ganado (EVM) para la prueba técnica de Trycore</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <spring.profiles.active>dev</spring.profiles.active>
        <springdoc.version>3.1.0</springdoc.version>
        <archunit.version>1.5.0</archunit.version>
        <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
        <!-- Directorios de test que revisa Checkstyle. El perfil test añade el de integración. -->
        <checkstyle.testSourceDirectory>${project.basedir}/src/test/java</checkstyle.testSourceDirectory>
        <checkstyle.integrationTestSourceDirectory>${project.basedir}/src/test/java</checkstyle.integrationTestSourceDirectory>
        <checkstyle.skip>false</checkstyle.skip>
        <jacoco.plugin.version>0.8.13</jacoco.plugin.version>
        <jacoco.line.minimum>0.80</jacoco.line.minimum>
        <jacoco.branch.minimum>0.80</jacoco.branch.minimum>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- En Spring Boot 4 la autoconfiguración de Flyway se separó del propio flyway-core a -->
        <!-- este módulo aparte (antes normalmente llegaba a través de spring-boot-starter-flyway); -->
        <!-- sin el, Flyway nunca se ejecuta al arrancar aunque flyway-core este en el classpath. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>evm-backend</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>application.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>application.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Checkstyle corre en la fase validate y es bloqueante en los tres perfiles: un linter -->
            <!-- que solo avisa termina ignorado, y el proyecto exige cero code smells. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <skip>${checkstyle.skip}</skip>
                    <!-- Se listan explícitamente porque Checkstyle corre en validate, antes de que
                         build-helper añada el source root de integración en generate-test-sources. -->
                    <testSourceDirectories>
                        <testSourceDirectory>${checkstyle.testSourceDirectory}</testSourceDirectory>
                        <testSourceDirectory>${checkstyle.integrationTestSourceDirectory}</testSourceDirectory>
                    </testSourceDirectories>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- JaCoCo instrumenta el código en los tres perfiles; solo el perfil test agrega la -->
            <!-- meta check con el umbral de cobertura sobre domain y application. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Perfil dev: activo por defecto. Devtools, solo tests unitarios, JaCoCo solo reporte. -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <spring.profiles.active>dev</spring.profiles.active>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-devtools</artifactId>
                    <scope>runtime</scope>
                    <optional>true</optional>
                </dependency>
            </dependencies>
        </profile>

        <!-- Perfil test: Testcontainers, ArchUnit, failsafe para *IT y JaCoCo check bloqueante. -->
        <!-- Se activa explícitamente con -Ptest. -->
        <profile>
            <id>test</id>
            <properties>
                <spring.profiles.active>test</spring.profiles.active>
                <checkstyle.integrationTestSourceDirectory>${project.basedir}/src/test-integration/java</checkstyle.integrationTestSourceDirectory>
            </properties>
            <dependencies>
                <!-- spring-boot-testcontainers aporta la anotación @ServiceConnection que exige -->
                <!-- ApplicationStartsIT; no esta en la lista original de dependencias del perfil -->
                <!-- pero es imprescindible para que esa anotación exista en el classpath. -->
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-testcontainers</artifactId>
                    <scope>test</scope>
                </dependency>
                <!-- En Spring Boot 4 TestRestTemplate se movió a este módulo aparte (antes venía -->
                <!-- incluido en spring-boot-starter-test); también es imprescindible para ApplicationStartsIT. -->
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-resttestclient</artifactId>
                    <scope>test</scope>
                </dependency>
                <!-- spring-boot-resttestclient necesita RestTemplateBuilder en tiempo de ejecución, -->
                <!-- que este módulo aporta; el starter web no lo trae porque es del lado cliente. -->
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-restclient</artifactId>
                    <scope>test</scope>
                </dependency>
                <!-- Testcontainers 2.x (la versión que gestiona el BOM de Spring Boot 4.1.1) renombró -->
                <!-- estos artefactos de "postgresql"/"junit-jupiter" a "testcontainers-postgresql" y -->
                <!-- "testcontainers-junit-jupiter"; los nombres antiguos ya no se publican en esa serie. -->
                <dependency>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>testcontainers-postgresql</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>testcontainers-junit-jupiter</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>com.tngtech.archunit</groupId>
                    <artifactId>archunit-junit5</artifactId>
                    <version>${archunit.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!-- HexagonalArchitectureTest y ApplicationStartsIT usan ArchUnit y Testcontainers, -->
                    <!-- dependencias exclusivas de este perfil, por lo que viven en un source root -->
                    <!-- aparte (src/test-integration/java) que solo se agrega a la compilación aquí; -->
                    <!-- así ./mvnw test con el perfil dev no intenta compilarlas sin esas dependencias. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-integration-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/test-integration/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>integration-test</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.plugin.version}</version>
                        <executions>
                            <!-- El agente de failsafe escribe en un fichero aparte para que la
                                 cobertura de los tests de integración no se pierda: sin esto el
                                 informe muestra 0 % en los adaptadores y no refleja lo que se
                                 prueba de verdad. -->
                            <execution>
                                <id>jacoco-prepare-agent-integration</id>
                                <goals>
                                    <goal>prepare-agent-integration</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>jacoco-report-integration</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>report-integration</goal>
                                </goals>
                            </execution>
                            <!-- Informe agregado con las dos ejecuciones, el que hay que abrir. -->
                            <execution>
                                <id>jacoco-merge</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>merge</goal>
                                </goals>
                                <configuration>
                                    <fileSets>
                                        <fileSet>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>jacoco*.exec</include>
                                            </includes>
                                        </fileSet>
                                    </fileSets>
                                    <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-report-merged</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <configuration>
                                    <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                                    <outputDirectory>${project.build.directory}/site/jacoco-merged</outputDirectory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <includes>
                                                <include>com.trycore.evm.domain.*</include>
                                                <include>com.trycore.evm.application.*</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.line.minimum}</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.branch.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Perfil prod: sin devtools ni seed, configuración por variables de entorno. -->
        <profile>
            <id>prod</id>
            <properties>
                <spring.profiles.active>prod</spring.profiles.active>
            </properties>
        </profile>
    </profiles>
</project>
