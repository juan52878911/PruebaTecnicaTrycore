# Imagen de desarrollo del frontend.
#
# No copia el código: docker-compose monta frontend/ en /app y deja node_modules en un volumen con
# nombre, para que las dependencias de Linux no se mezclen con las del anfitrión. La imagen aporta
# Node y el script de arranque, que instala las dependencias solo cuando cambia package-lock.json.
FROM node:22-alpine

# La misma versión de npm que declara package.json en packageManager: la que trae la imagen
# resuelve las dependencias opcionales de otra forma y rechaza el package-lock.json del repositorio.
ARG NPM_VERSION=11.6.2
RUN npm install -g "npm@${NPM_VERSION}" --no-audit --no-fund

WORKDIR /app

ENV NG_CLI_ANALYTICS=false

COPY docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-entrypoint.sh

EXPOSE 4200

CMD ["dev-entrypoint.sh"]
